# Quote form (api/contact.ts). Set these in Vercel → Settings → Environment Variables,
# and in .env.local to try the function with `vercel dev`. Never commit real values.

# Secret key from https://resend.com/api-keys
RESEND_API_KEY=

# Where the requests arrive (optional, default: linamanigo@gmail.com)
CONTACT_TO=linamanigo@gmail.com

# Sender, on a domain verified in Resend (optional, default below)
CONTACT_FROM="Lina Nieto <contacto@linanieto.com>"
